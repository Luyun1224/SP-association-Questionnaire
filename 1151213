/* ===================== Render ===================== */
const $ = (s, el = document) => el.querySelector(s);
const $$ = (s, el = document) => [...el.querySelectorAll(s)];
const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

function withReq(t) { const s = String(t); return `${esc(s.slice(0, -1))}<span class="nw">${esc(s.slice(-1))}<span class="req">＊</span></span>`; }
function likert(q) {
  return `<div class="likert" role="radiogroup" aria-label="${esc(q.text)}">` +
    SCALE.map(s => `<label class="lk"><input type="radio" name="${q.col}" value="${s.v}"><span class="lk-btn"><b>${s.v}</b><small>${s.l}</small></span></label>`).join('') +
    `</div><p class="q-err">這題還沒有選喔</p>`;
}
function qBlock(q) {
  return `<div class="q${q.hl ? ' hl' : ''}" data-req="${q.col}">
    <div class="q-head"><span class="q-no">${q.id}</span><p class="q-text">${withReq(q.text)}</p></div>
    ${likert(q)}</div>`;
}
function goalBlock(q) {
  return `<div class="q" data-req="${q.col}">
    <div class="q-head"><span class="g-icon">${ICONS[q.icon]}</span>
      <p class="q-text"><span class="g-tag">${q.id}｜${esc(q.tag)}</span>${withReq(q.text)}</p></div>
    ${likert(q)}</div>`;
}
function chips(list, name, type) {
  return list.map(v => `<label class="chip"><input type="${type}" name="${name}" value="${esc(v)}"><span>${esc(v)}</span></label>`).join('');
}

$('#yearChips').innerHTML = chips(YEARS, 'SP年資', 'radio');
$('#topicChips').innerHTML = chips(TOPICS, '希望主題', 'checkbox');
$('#sessions').innerHTML = SESSIONS.map(s => `
  <div class="session">
    <div class="s-head"><span class="s-time">${s.time}</span><span class="s-topic">${esc(s.topic)}</span><span class="s-spk">講師｜${s.speakers.map(n => `<span>${esc(n)}</span>`).join('、')}</span></div>
    <div class="s-body">${s.items.map(qBlock).join('')}</div>
  </div>`).join('');
$('#goals').innerHTML = GOALS.map(goalBlock).join('');
$('#overall').innerHTML = OVERALL.map(qBlock).join('');

const LIKERT_COLS = [...SESSIONS.flatMap(s => s.items), ...GOALS, ...OVERALL].map(q => q.col);
const form = $('#form');
if (!CONFIG.GAS_URL) $('#demoBanner').hidden = false;

/* ===================== Logic ===================== */
function val(name) {
  const els = form.elements[name];
  if (!els) return '';
  if (els instanceof RadioNodeList) return els.value || '';
  return (els.value || '').trim();
}
function syncConditional() {
  $('#topicOtherWrap').hidden = !$('input[name="希望主題"][value="其他"]').checked;
}

function requiredKeys() {
  return ['姓名', 'SP年資'].concat(LIKERT_COLS);
}

function updateProgress() {
  const keys = requiredKeys();
  let done = 0;
  keys.forEach(k => {
    const ok = !!val(k);
    if (ok) done++;
    const box = $(`[data-req="${k}"]`);
    if (box) {
      box.classList.toggle('done', ok);
      if (ok) box.classList.remove('is-missing');
    }
  });
  $('#barFill').style.width = (done / keys.length * 100) + '%';
  $('#count').textContent = `${done} / ${keys.length}`;
}

/* 草稿暫存（不小心重新整理也不會不見） */
function saveDraft() {
  try {
    const d = {};
    new FormData(form).forEach((v, k) => { d[k] = d[k] ? [].concat(d[k], v) : v; });
    localStorage.setItem(CONFIG.DRAFT_KEY, JSON.stringify(d));
  } catch (e) {}
}
function loadDraft() {
  try {
    const d = JSON.parse(localStorage.getItem(CONFIG.DRAFT_KEY) || 'null');
    if (!d) return;
    Object.entries(d).forEach(([k, v]) => {
      const vals = [].concat(v);
      $$(`[name="${CSS.escape(k)}"]`).forEach(el => {
        if (el.type === 'radio' || el.type === 'checkbox') el.checked = vals.includes(el.value);
        else el.value = vals[0];
      });
    });
  } catch (e) {}
}
function clearDraft() { try { localStorage.removeItem(CONFIG.DRAFT_KEY); } catch (e) {} }

form.addEventListener('change', () => { syncConditional(); updateProgress(); saveDraft(); });
form.addEventListener('input', e => { if (e.target.matches('textarea,input[type=text]')) { saveDraft(); if (e.target.id === 'name') updateProgress(); } });

let toastTimer;
function toast(msg) {
  const t = $('#toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove('show'), 2600);
}

function validate() {
  const missing = requiredKeys().filter(k => !val(k));
  $$('.is-missing').forEach(el => el.classList.remove('is-missing'));
  missing.forEach(k => { const box = $(`[data-req="${k}"]`); if (box) box.classList.add('is-missing'); });
  if (missing.length) {
    const first = $(`[data-req="${missing[0]}"]`);
    const y = first.getBoundingClientRect().top + window.scrollY - $('#progress').offsetHeight - 16;
    window.scrollTo({ top: y, behavior: 'smooth' });
    first.classList.remove('shake'); void first.offsetWidth; first.classList.add('shake');
    toast(`還有 ${missing.length} 題未完成`);
    return false;
  }
  return true;
}

function uid() {
  return 'R' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 6).toUpperCase();
}

function buildPayload() {
  const p = {
    回應ID: uid(),
    活動名稱: CONFIG.EVENT_NAME,
    活動日期: CONFIG.EVENT_DATE,
    姓名: val('姓名'),
    SP年資: val('SP年資')
  };
  LIKERT_COLS.forEach(c => { p[c] = Number(val(c)); });
  const topics = $$('input[name="希望主題"]:checked').map(i => i.value);
  p.希望主題 = topics.join('、');
  p.希望主題_其他 = topics.includes('其他') ? val('希望主題_其他') : '';
  p.最大收穫 = val('最大收穫');
  p.困難情境 = val('困難情境');
  p.其他建議 = val('其他建議');
  p.裝置 = /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent) ? '行動裝置' : '電腦';
  return p;
}

async function send(payload) {
  if (!CONFIG.GAS_URL) { await new Promise(r => setTimeout(r, 700)); console.log('[預覽模式] payload', payload); return { ok: true, demo: true }; }
  const body = JSON.stringify(payload);
  const headers = { 'Content-Type': 'text/plain;charset=utf-8' };
  let res;
  try {
    res = await fetch(CONFIG.GAS_URL, { method: 'POST', body, headers });
  } catch (netErr) {
    // 部分環境擋 CORS 讀取：改用 no-cors 送出（後端以回應ID防止重複）
    await fetch(CONFIG.GAS_URL, { method: 'POST', mode: 'no-cors', body, headers });
    return { ok: true, blind: true };
  }
  const j = await res.json().catch(() => ({ ok: res.ok }));
  if (!j.ok) throw new Error(j.error || '寫入失敗');
  return j;
}

form.addEventListener('submit', async e => {
  e.preventDefault();
  if (!validate()) return;
  const btn = $('#btnSubmit');
  btn.disabled = true; btn.classList.add('loading'); $('#btnText').textContent = '送出中…';
  try {
    await send(buildPayload());
    clearDraft();
    form.hidden = true;
    $('#done').hidden = false;
    window.scrollTo({ top: $('#done').getBoundingClientRect().top + window.scrollY - 90, behavior: 'smooth' });
    $('#progress').hidden = true;
    $('.intro').hidden = true;
    confetti();
  } catch (err) {
    toast('送出失敗，請確認網路後再試一次');
    console.error(err);
  } finally {
    btn.disabled = false; btn.classList.remove('loading'); $('#btnText').textContent = '送出問卷';
  }
});

$('#btnAgain').addEventListener('click', () => {
  form.reset();
  $$('.done,.is-missing').forEach(el => el.classList.remove('done', 'is-missing'));
  syncConditional(); updateProgress();
  $('#done').hidden = true; form.hidden = false; $('#progress').hidden = false; $('.intro').hidden = false;
  window.scrollTo({ top: 0, behavior: 'smooth' });
});

function confetti() {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const colors = ['#FD7F01', '#FDB858', '#259F93', '#017878', '#FFD9A8'];
  for (let i = 0; i < 46; i++) {
    const c = document.createElement('i');
    c.className = 'confetti';
    c.style.left = Math.random() * 100 + 'vw';
    c.style.background = colors[i % colors.length];
    c.style.setProperty('--dx', (Math.random() * 160 - 80) + 'px');
    c.style.setProperty('--r', (Math.random() * 720 - 360) + 'deg');
    c.style.animationDuration = (1.8 + Math.random() * 1.4) + 's';
    c.style.animationDelay = (Math.random() * .3) + 's';
    if (i % 3 === 0) { c.style.width = '8px'; c.style.height = '8px'; c.style.borderRadius = '50%'; }
    document.body.appendChild(c);
    setTimeout(() => c.remove(), 3600);
  }
}

/* 進場動畫 */
const io = 'IntersectionObserver' in window ? new IntersectionObserver(es => es.forEach(en => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } }), { threshold: .08 }) : null;
$$('.reveal').forEach(el => io ? io.observe(el) : el.classList.add('in'));

loadDraft();
syncConditional();
updateProgress();
</script>
</body>
